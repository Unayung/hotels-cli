    with Client(args) as cl:
        for ref in args.refs:
            pid = product_id(ref)
            crit = search_criteria(args.region_id, None, args.checkin, args.checkout, rooms)
            rooms_vars = {"context": cl.context(args.currency), "skipRatePlans": False,
                         "includeStickyBarPriceSummary": False, "propertyId": pid, "searchCriteria": crit,
                         "shoppingContext": {"multiItem": None, "queryTriggeredBy": "OTHER"},
                         "travelAdTrackingInfo": None, "searchOffer": None, "referrer": None,
                         "selectedSavedQuoteInput": None,
                         "productIdentifier": {"id": pid, "type": "PROPERTY_ID", "travelSearchCriteria": {"property": crit}}}
            try:
                offers = parse_rooms_response(
                    cl.gql("RoomsAndRatesPropertyOffersQuery", rooms_vars, HASH_ROOMS, CI_SHOP), args.currency)
                prices = [p for u in offers["units"] for rp in u["rate_plans"] for p in [rp["price_per_night"]] if p]
