                   "`hotels hotel <id>` (measured: id 134096514 \"To-Fu-rou\" NT$304/night = its \"共用宿舍, "
                   "僅限女士\" shared dormitory room for this 3-adult+1-child search).",
               "items": items}
    return emit(ok(data_out), args.json, lambda: (
