def cmd_hotel(args):
    pid = product_id(args.ref)
    rooms = build_rooms(args.adults, args.children, args.rooms)
    with Client(args) as cl:
        crit = search_criteria(args.region_id, None, args.checkin, args.checkout, rooms)
        base_vars = {"context": cl.context(args.currency), "propertyId": pid,
                    "shoppingContext": {"multiItem": None, "queryTriggeredBy": "OTHER"}, "searchCriteria": crit}
        prop = parse_property(cl.gql("PropertyDetailsBasicQuery", base_vars, HASH_PROPERTY, CI_SHOP))
        glance = parse_ataglance(cl.gql("AtAGlanceQuery", {
            "context": cl.context(args.currency),
            "productIdentifier": {"id": pid, "type": "PROPERTY_ID",
            "travelSearchCriteria": {"property": crit}, "shoppingContext": {"multiItem": None, "queryTriggeredBy": "OTHER"}}},
            HASH_ATAGLANCE, CI_SHOP))
        rooms_vars = {"context": cl.context(args.currency), "skipRatePlans": False,
                     "includeStickyBarPriceSummary": False, "propertyId": pid, "searchCriteria": crit,
                     "shoppingContext": {"multiItem": None, "queryTriggeredBy": "OTHER"},
                     "travelAdTrackingInfo": None, "searchOffer": None, "referrer": None,
                     "selectedSavedQuoteInput": None,
                     "productIdentifier": {"id": pid, "type": "PROPERTY_ID", "travelSearchCriteria": {"property": crit}}}
        offers = parse_rooms_response(cl.gql("RoomsAndRatesPropertyOffersQuery", rooms_vars, HASH_ROOMS, CI_SHOP),
                                      args.currency)
    data_out = {"id": pid, "checkin": args.checkin, "checkout": args.checkout, **prop, **glance, **offers}
    def human():
        lines = [f"id {pid}", f"check-in {data_out.get('checkin_time') or '?'}  check-out {data_out.get('checkout_time') or '?'}",
                 "amenities: " + ", ".join(data_out.get("amenities") or []) or "amenities: -",
                 f"saved to favourites: {data_out.get('saved')}"]
        if data_out.get("unavailable_reason"):
            lines.append("UNAVAILABLE: " + data_out["unavailable_reason"])
        for u in data_out.get("units") or []:
            lines.append(f"\n[{u['unit_id']}] {u['name']}")
            lines.append("  " + " / ".join(u["features"][:6]))
            for rp in u["rate_plans"]:
                lines.append(f"  rate {rp['rate_plan_id']}: {nt(rp['price_per_night'], args.currency)}/night, "
                             f"total {nt(rp['price_total'], args.currency)}  {rp['cancellation'] or ''}  "
                             f"{rp['availability_note'] or ''}")
        return "\n".join(lines)
    return emit(ok(data_out), args.json, human)


def cmd_price(args):
