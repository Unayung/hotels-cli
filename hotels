def cmd_doctor(args):
    checks = []
    st = load_state()
    checks.append(["state", "ok" if os.path.exists(STATE_FILE) else "-", STATE_FILE])
    try:
        ver = _http_json("/json/version")
        checks.append(["cdp", "ok", f"{CDP} {ver.get('Browser')}"])
    except Net as e:
        # Edge is only required without curl_cffi (and for trips / saved)
        checks.append(["cdp", "-" if cffi else "FAIL", f"{e} (needed for trips/saved)" if cffi else str(e)])
        if not cffi:
            payload = err("doctor found problems", EX_NET, checks=checks)
            return emit(payload, args.json, lambda: table(checks, ["check", "state", "detail"]))

    cl = Client(argparse.Namespace(via="http", debug=args.debug), st)
    try:
        if args.via != "http":
            raise Net("skipped (default transport is the Edge tab; `doctor --via http` probes plain HTTPS)")
        code, text = cl.http.fetch("GET", ORIGIN + "/", None, None)
        how = "curl_cffi (Chrome TLS)" if cffi else "urllib"
        checks.append(["http", "ok" if code < 400 else "blocked", f"HTTPS {code} via {how} (opt-in --via http)"])
    except Net as e:
        checks.append(["http", "-", str(e)])

    gq = "graphql (plain HTTPS)" if args.via == "http" else "graphql (browser tab)"
    cl2 = Client(argparse.Namespace(via="http" if args.via == "http" else "browser", debug=args.debug), st)
    try:
        d = cl2.gql("SearchLocationSuggestions", {
            "context": cl2.context(), "searchLocationCriteria": {"searchTerm": "東京", "lineOfBusiness": "HOTELS",
            "isDestination": True, "isGroundTransfersAirport": False, "pageLocation": "ENTRY"}},
            HASH_TYPEAHEAD, CI_LOTUS)
        n = len(parse_suggest(d))
        checks.append([gq, "ok" if n else "FAIL", f"typeahead 東京: {n} suggestion(s)"])
    except (Net, ApiError) as e:
        checks.append([gq, "FAIL", str(e)])
    finally:
        cl2.__exit__()

    if st.get("cookies"):
        if _signed_in(st["cookies"]):
            checks.append(["login", "ok", f"EG_SESSIONTOKEN present via {st.get('source')}"])
        else:
            checks.append(["login", "FAIL", "saved cookies have no EG_SESSIONTOKEN - run `hotels login`"])
    else:
        checks.append(["login", "-", "not signed in (search/hotel/price work; whoami/saved/trips need login)"])
    bad = any(c[1] == "FAIL" for c in checks)
    payload = err("doctor found problems", EX_NET, checks=checks) if bad else ok({"checks": checks})
    return emit(payload, args.json, lambda: table(checks, ["check", "state", "detail"]))


def cmd_suggest(args):
    with Client(args) as cl:
        d = cl.gql("SearchLocationSuggestions", {
            "context": cl.context(args.currency),
            "searchLocationCriteria": {"searchTerm": args.text, "lineOfBusiness": "HOTELS",
            "isDestination": True, "isGroundTransfersAirport": False, "pageLocation": "ENTRY"}},
            HASH_TYPEAHEAD, CI_LOTUS)
    items = parse_suggest(d)[: args.limit]
    return emit(ok({"query": args.text, "items": items}), args.json, lambda: table(
        [[i["region_id"], i["name"], i["area"], i["type"]] for i in items],
        ["region_id", "name", "area", "type"]))


def resolve_destination(cl, dest, currency):
    if re.fullmatch(r"\d+", str(dest)):
        return str(dest), None
    d = cl.gql("SearchLocationSuggestions", {
        "context": cl.context(currency),
        "searchLocationCriteria": {"searchTerm": dest, "lineOfBusiness": "HOTELS",
        "isDestination": True, "isGroundTransfersAirport": False, "pageLocation": "ENTRY"}},
        HASH_TYPEAHEAD, CI_LOTUS)
    items = parse_suggest(d)
    if not items:
        raise ApiError(f"no destination matched {dest!r}")
    top = items[0]
    return top["region_id"], top["full_name"]


def cmd_search(args):
    if args.limit < 1 or args.page < 1:
        raise Usage("--limit and --page must be >= 1")
    rooms = build_rooms(args.adults, args.children, args.rooms)
    sort_enum = SORTS[args.sort or "recommended"]
    selections = [{"id": "sort", "value": sort_enum}]
    for s in args.stars or []:
        selections.append({"id": "star", "value": str(int(s) * 10)})
    if args.free_cancel:
        selections.append({"id": "propertyCancellation", "value": "FREE_CANCELLATION"})
    if args.breakfast:
        selections.append({"id": "mealPlan", "value": "FREE_BREAKFAST"})

    offset = (args.page - 1) * args.limit
    needed = args.page * args.limit

    def passes_filter(r):
        if args.min is not None and (r["price_per_night"] is None or r["price_per_night"] < args.min):
            return False
        if args.max is not None and (r["price_per_night"] is None or r["price_per_night"] > args.max):
            return False
        return True

    with Client(args) as cl:
        region_id, region_name = resolve_destination(cl, args.destination, args.currency)
        crit = search_criteria(region_id, region_name, args.checkin, args.checkout, rooms)
        crit["secondary"]["selections"] = selections
        remote_page_size = 100
        collected, raw_fetched = [], 0
        matched_total = None
        seen_ids = set()

        while True:
            crit["secondary"]["counts"] = [{"id": "resultsStartingIndex", "value": raw_fetched},
                                          {"id": "resultsSize", "value": remote_page_size}]
            variables = {"isMultiItem": False, "includeMultiItem": False, "context": cl.context(args.currency),
                        "criteria": crit, "shoppingContext": {"queryTriggeredBy": "sort_applied",
                        "typeaheadCollationId": None}}
            data = cl.gql("SearchResultsAndFilters", variables, HASH_SEARCH, CI_SHOP)
            parsed = parse_search_response(data, args.currency)
            matched_total = parsed["matched_total"]
            raw_listings = data.get("propertySearch", {}).get("propertySearchListings") or []
            batch_raw_count = len(raw_listings)

            for item in parsed["items"]:
                if item["id"] not in seen_ids:
                    seen_ids.add(item["id"])
                    if passes_filter(item):
                        collected.append(item)

            raw_fetched += batch_raw_count
            if len(collected) >= needed or batch_raw_count == 0 or raw_fetched >= 400:
                break

        items = collected[offset: needed]
    data_out = {"destination": args.destination, "matched_region": region_name or region_id, "region_id": region_id,
               "checkin": args.checkin, "checkout": args.checkout, "sort": args.sort or "recommended",
               "page": args.page, "count": len(items), "matched_total": matched_total,
               "price_basis_note": "every item's price_per_night/price_total come from the same hotels.com "
                   "LEAD/總價 pair, so price sorts compare like with like (measured monotonic). Low per-night "
                   "prices at budget properties can be a shared-dorm BED rate, not a private room - hotels.com's "
