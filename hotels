    return emit(ok(rows), args.json, lambda: table(
        [[r["id"], nt(r.get("lowest_price_per_night"), args.currency) if r["found"] else "ERR",
          r.get("unavailable_reason") or r.get("error") or ""] for r in rows],
        ["id", "lowest/night", "note"]))


def cmd_raw(args):
    url = args.path if args.path.startswith("http") else ORIGIN + "/" + args.path.lstrip("/")
    u = urllib.parse.urlparse(url)
    if u.hostname not in ("tw.hotels.com", "hotels.com"):
        raise Usage("raw only talks to tw.hotels.com")
    if re.search(r"checkout|book|reservation|payment", u.path, re.I):
        raise Usage("raw refuses checkout/book/reservation/payment paths")
    with Client(args) as cl:
        code, text = cl.fetch("GET", url)
    try:
        body = json.loads(text)
    except ValueError:
        body = text[:20000]
    return emit(ok({"http": code, "url": url, "body": body}), True)


# ---------------------------------------------------------------- session
def homepage_login_state(cl):
    """Parse the raw SSR homepage HTML for the signed-in member's display name."""
    code, html = cl.fetch("GET", ORIGIN + "/")
    if code >= 400:
        raise ApiError(f"homepage: HTTP {code}")
    # Several header buttons share data-testid="header-menu-button" AND the
    # class "global-navigation-nav-button" (nav menu "旅遊產品", currency
    # picker, account), so neither alone is unique - re-measured 2026-10-30:
    # only the account button additionally carries "uitk-button-tertiary-
    # large-icon" (the earlier regex matched "global-navigation-nav-button"
    # alone and grabbed the FIRST such button, the nav-menu one - that was
    # bug #1, now fixed by requiring the large-icon class too).
    m = re.search(r'<button title="([^"]*)"[^>]*class="[^"]*uitk-button-tertiary-large-icon[^"]*"', html)
    name = htmllib.unescape(m.group(1)) if m else None
    return name


def login_from_browser(args):
    _set_cdp(args.cdp)
    cookies, ua = edge_cookies()
    if _signed_in(cookies):
        return cookies, ua
    br = Browser(args.debug, LOGIN_URL, wait=True)
    try:
        br.eval("""
        (() => {
          const b = Array.from(document.querySelectorAll('button')).find(x => (x.innerText||'').trim()==='登入');
          if (b) b.click();
        })()
        """)
        print(f"Sign in to Hotels.com in the new background tab of the browser on {CDP} "
              f"(switch to it yourself). Waiting up to {args.wait}s...", file=sys.stderr)
        t0 = time.time()
        while time.time() - t0 < args.wait:
            time.sleep(4)
            cookies, ua = edge_cookies()
            if _signed_in(cookies):
                return cookies, ua
        raise Auth(f"not signed in after {args.wait}s; run `hotels login` again")
    finally:
        br.close()


LOGIN_HOWTO = ("no hotels.com Cookie header found. In the browser: DevTools > Network > click any "
               "request to tw.hotels.com > Request Headers > copy the `Cookie:` value, "
               "then run `hotels login` again (or pipe it in)")


def cmd_login(args):
    default = not (args.from_clipboard or args.cookie_stdin or args.from_browser)
    if default:
        try:
            raw = _clipboard() if sys.stdin.isatty() else sys.stdin.read()
            clean_cookie(raw)
        except Auth:
            raise Usage(LOGIN_HOWTO)
    if default or args.from_clipboard or args.cookie_stdin:
        if not default:
            raw = _clipboard() if args.from_clipboard else \
                (_read_cookie_tty() if sys.stdin.isatty() else sys.stdin.read())
        cookies = header_to_cookies(clean_cookie(raw))
        ua = os.environ.get("HOTELS_UA") or DEFAULT_UA
        src = "clipboard" if args.from_clipboard or (default and sys.stdin.isatty()) else "stdin"
    else:
        cookies, ua = login_from_browser(args)
        src = f"browser {CDP}"
    st = {"cookies": cookies, "ua": ua}
    cl = Client(argparse.Namespace(via=args.via, debug=args.debug, cdp=getattr(args, "cdp", None)), st)
    try:
        name = homepage_login_state(cl)
    finally:
        cl.__exit__()
    if not name:
        raise Auth("session saved but the homepage did not show a signed-in member name - "
                   "sign-in may not have completed")
    st2 = load_state()
    st2.pop("source", None)
    st2.update(cookies=cookies, ua=ua, cookie_in_keyring=bool(args.keyring), user={"name": name},
              logged_in_at=int(time.time()), login_source=src)
    if st2.get("keyring_parts"):
        keyring_clear(st2["keyring_parts"])
    st2.pop("keyring_parts", None)
    st2.pop("keyring_error", None)
    if args.keyring:
        st2["keyring_parts"] = keyring_save(cookies)
        if keyring_load(st2["keyring_parts"]) != cookies:
            raise Auth("keyring did not return the session it was given; use the state file")
    save_state(st2)
    out = {"user": {"name": name}, "stored": "keyring" if args.keyring else STATE_FILE, "cookies": len(cookies)}
    return emit(ok(out), args.json, lambda: f"signed in as {name}; session ({len(cookies)} cookies) saved to {out['stored']}")


def cmd_logout(args):
    st = load_state()
    if st.get("cookie_in_keyring"):
        keyring_clear(st.get("keyring_parts"))
    for k in ("cookies", "cookie_in_keyring", "keyring_parts", "keyring_error", "user",
              "logged_in_at", "login_source", "source", "ua"):
        st.pop(k, None)
    save_state(st)
    return emit(ok({"logged_out": True}), args.json, "session removed")


def cmd_whoami(args):
    st = load_state()
    if not st.get("cookies") or not _signed_in(st["cookies"]):
        raise Auth(st.get("keyring_error") or "not signed in - run `hotels login`")
    with Client(argparse.Namespace(via=args.via, debug=args.debug, cdp=None), st) as cl:
        name = homepage_login_state(cl)
    if not name:
        raise Auth("saved session rejected - the homepage no longer shows a signed-in member")
    out = {"name": name, "source": st.get("source")}
    return emit(ok(out), args.json, lambda: f"{name}\nsession via {out['source']} (verified against the live homepage)")


def _clipboard():
    for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-o", "-selection", "clipboard"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    raise Auth("clipboard is empty or no clipboard tool (wl-paste / pbpaste / xclip)")


def _read_cookie_tty():
    import termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    print("paste the Cookie header, then press Enter (input hidden):", file=sys.stderr)
    buf = bytearray()
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        while True:
            ch = os.read(fd, 65536)
            if not ch:
                break
            if b"\x03" in ch:
                raise KeyboardInterrupt
            buf += ch
            if b"\r" in ch or b"\n" in ch:
                break
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        print(file=sys.stderr)
    return buf.decode("utf-8", "replace").splitlines()[0] if buf else ""


