    except (OSError, ValueError) as e:
        raise ApiError(f"state file unreadable: {e}")
    if os.environ.get("HOTELS_COOKIE"):
        st["cookies"], st["source"] = header_to_cookies(clean_cookie(os.environ["HOTELS_COOKIE"])), "env"
    elif st.get("cookie_in_keyring"):
        try:
            st["cookies"] = keyring_load(st.get("keyring_parts"))
        except Auth as e:
            st["cookies"], st["keyring_error"] = [], str(e)
        st["source"] = "keyring"
    elif st.get("cookies"):
        st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k not in ("source", "keyring_error")}
    if out.get("cookie_in_keyring"):
        out.pop("cookies", None)
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def cookie_for(cookies, url):
    host = urllib.parse.urlparse(url).hostname or ""
    seen, parts = set(), []
    for c in cookies or []:
        d = c.get("domain") or ".hotels.com"
        hit = host == d.lstrip(".") or (d.startswith(".") and host.endswith(d))
        if hit and c["name"] not in seen:
            seen.add(c["name"])
            parts.append(f"{c['name']}={c['value']}")
    return "; ".join(parts)


def clean_cookie(raw):
    raw = (raw or "").strip()
    if raw.lower().startswith("cookie:"):
        raw = raw.split(":", 1)[1].strip()
    pairs = [p.strip() for p in raw.replace("\n", ";").split(";")]
    good_re = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+=[\x21-\x7e]*$")
    good = [p for p in pairs if p and good_re.match(p)]
    bad = [p for p in pairs if p and not good_re.match(p)]
    if not any(p.startswith("EG_SESSIONTOKEN=") for p in good):
        preview = raw[:40].encode("ascii", "replace").decode()
        raise Auth("that does not look like a signed-in hotels.com Cookie header (no "
                   f"EG_SESSIONTOKEN; starts with {preview!r}). DevTools > Network > a "
                   "tw.hotels.com request > Request Headers > copy the value of `Cookie`")
    if bad:
        print(f"note: dropped {len(bad)} malformed cookie part(s)", file=sys.stderr)
    return "; ".join(good)


def _signed_in(cookies):
    return any(c["name"] == "EG_SESSIONTOKEN" for c in cookies or [])


# -------------------------------------------------------------- transport
def is_challenge(code, text):
    head = (text or "")[:2000]
    return code in (403, 429, 503) and ("Too Many Requests" in head or "<" in head[:200]
                                        or "Just a moment" in head or "datadome" in head.lower())


class Http:
    """Plain HTTPS, used only with `--via http`. urllib is challenged on the first request;
    curl_cffi (Chrome TLS) passes for a short grace (~40 requests on 2026-10-30) and then
    this IP + fingerprint gets the captcha even without cookies. See the module docstring."""

    def __init__(self, st, debug=False):
        self.st, self.debug = st, debug
        self.ua = os.environ.get("HOTELS_UA") or st.get("ua") or DEFAULT_UA

    def fetch(self, method, url, body=None, headers=None):
        h = {"User-Agent": self.ua, "Accept-Language": "zh-TW,zh;q=0.9,en;q=0.8",
             "Origin": ORIGIN, "Referer": ORIGIN + "/"}
        h.update(headers or {})
        ck = cookie_for(self.st.get("cookies"), url)
        if ck:
            h["Cookie"] = ck
        data = body.encode() if isinstance(body, str) else body
        if self.debug:
            print(f"> {method} {url} {(body or '')[:300]}", file=sys.stderr)
        if cffi:
            # The browser's `datadome` cookie is bound to the browser's fingerprint: sent from
            # curl_cffi it gets the 429 captcha page, while no datadome cookie passes. The UA
            # must match the impersonated Chrome, so let curl_cffi set it.
            del h["User-Agent"]
            if ck:
                h["Cookie"] = "; ".join(p for p in ck.split("; ") if not p.startswith("datadome="))
            try:
                r = cffi.request(method, url, headers=h, data=data, impersonate="chrome", timeout=25)
            except Exception as e:
                raise Net(f"{urllib.parse.urlparse(url).netloc}: {e}")
            if self.debug:
                print(f"< {r.status_code} {r.text[:300]}", file=sys.stderr)
            return r.status_code, r.text
        req = urllib.request.Request(url, data=data, headers=h, method=method)
        try:
            with urllib.request.urlopen(req, timeout=25) as r:
                code, text = r.status, r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            code, text = e.code, e.read().decode("utf-8", "replace")
        except OSError as e:
            raise Net(f"{urllib.parse.urlparse(url).netloc}: {e}")
        if self.debug:
            print(f"< {code} {text[:300]}", file=sys.stderr)
        return code, text


class Client:
    """Every call runs in a background tab of the user's Edge (auto/browser) unless
    `--via http` asks for plain HTTPS (see Http for why that is opt-in)."""

    def __init__(self, args, st=None):
        self.args = args
        self.st = st if st is not None else load_state()
        self.http = Http(self.st, getattr(args, "debug", False))
        self.br = None
        self._duaid = (self.st.get("cookies") and next(
            (c["value"] for c in self.st["cookies"] if c["name"] == "DUAID"), None)) or str(uuid.uuid4())

    def browser(self):
        if not self.br:
            self.br = Browser(getattr(self.args, "debug", False))
        return self.br

    def fetch(self, method, url, body=None, headers=None, session=False):
        via = getattr(self.args, "via", "auto")
        if session and not self.st.get("cookies"):
            raise Auth("not signed in - run `hotels login`")
        if via == "http":  # opt-in only: non-browser clients get a short grace, then a captcha (see Http)
            code, text = self.http.fetch(method, url, body, headers)
            if is_challenge(code, text):
                raise Blocked(f"{urllib.parse.urlparse(url).netloc}: bot wall (HTTP {code}) on plain HTTPS - "
                              "drop `--via http` to use the Edge tab; don't retry")
            return code, text
        return self.browser().fetch(method, url, body, headers)

    def gql(self, op, variables, hash_, client_info=CI_SHOP, session=False):
        body = json.dumps([{"operationName": op, "variables": variables,
                            "extensions": {"persistedQuery": {"version": 1, "sha256Hash": hash_}}}])
        headers = {"content-type": "application/json", "accept": "application/json, multipart/mixed",
                   "x-apollo-operation-name": op, "x-apollo-operation-type": "query",
                   "client-info": client_info}
        code, text = self.fetch("POST", GRAPHQL, body, headers, session=session)
        if code == 401:
            raise Auth(f"{op}: not signed in (HTTP 401) - run `hotels login`")
        try:
            d = json.loads(text)
        except ValueError:
            raise ApiError(f"{op}: non-JSON reply (HTTP {code})", {"http": code, "body": text[:300]})
        item = (d[0] if isinstance(d, list) else d) or {}
        if item.get("errors") and not item.get("data"):
            raise ApiError(op + ": " + "; ".join(e.get("message", "") for e in item["errors"])[:400],
                          {"errors": item["errors"]})
        if code >= 400:
            raise ApiError(f"{op}: HTTP {code}", {"http": code, "body": text[:300]})
        return item.get("data") or {}

    def context(self, currency="TWD"):
        return {"siteId": 300000045, "locale": "zh_TW", "eapid": 45, "tpid": 3211, "currency": currency,
                "device": {"type": "DESKTOP"}, "identity": {"duaid": self._duaid, "authState": "AUTHENTICATED"},
                "privacyTrackingState": "CAN_TRACK"}

    def __enter__(self):
        return self

    def __exit__(self, *a):
        if self.br:
            self.br.close()


# --------------------------------------------------------------- parsing
def date_obj(s):
    try:
        y, m, d = s.split("-")
        return {"year": int(y), "month": int(m), "day": int(d)}
    except Exception:
        raise Usage(f"bad date {s!r}, expected YYYY-MM-DD")


def build_rooms(adults, children_ages, rooms):
    adults, rooms = int(adults), int(rooms)
    if adults < 1 or rooms < 1:
        raise Usage("--adults and --rooms must be >= 1")
    base, extra = divmod(adults, rooms)
    room_list = [{"adults": max(base + (1 if i < extra else 0), 1), "children": []} for i in range(rooms)]
    # Simplification (undocumented upstream how multi-room child assignment should
    # split): all requested child ages go into room 1, matching the traveler-selector
    # UI's own default when you only touch room 1's child stepper (measured live).
    for age in children_ages or []:
        room_list[0]["children"].append({"age": int(age)})
    return room_list


def search_criteria(region_id, region_name, checkin, checkout, rooms):
    return {
        "primary": {
            "destination": {"regionName": region_name, "regionId": region_id, "coordinates": None, "mapBounds": None},
            "rooms": rooms,
            "dateRange": {"checkInDate": date_obj(checkin), "checkOutDate": date_obj(checkout)},
        },
        "secondary": {"counts": [], "booleans": [],
                      "selections": [{"id": "privacyTrackingState", "value": "CAN_TRACK"}], "ranges": []},
    }


def product_id(ref):
    ref = str(ref).strip()
    if re.fullmatch(r"\d+", ref):
        return ref
    m = re.search(r"expediaPropertyId=(\d+)", ref)
    if m:
        return m.group(1)
    raise Usage(f"not a hotels.com property id or URL with expediaPropertyId=: {ref!r}")


def money(formatted):
    return num(formatted)


def lead_and_total(display_messages):
    lead = total = None
    for block in display_messages or []:
        for li in block.get("lineItems") or []:
            if li.get("__typename") == "DisplayPrice" and li.get("role") == "LEAD":
                lead = money(li["price"]["formatted"])
            elif li.get("value") and "總價" in str(li.get("value")):
                total = money(li["value"])
    return lead, total


def parse_suggest(d):
    out = []
    groups = ((d.get("searchLocation") or {}).get("itemsGroups")) or []
    for g in groups:
        for it in g.get("items") or []:
            if it.get("regionId") is None:
                continue
            out.append({"region_id": it.get("regionId"), "name": it.get("primaryText"),
                       "full_name": it.get("locationFullName"), "area": it.get("secondaryText"),
                       "type": it.get("geoType"),
                       "coordinates": it.get("coordinates")})
    return out


def is_sponsored_listing(x):
    url = ((x.get("cardLink") or {}).get("resource") or {}).get("value") or ""
    impr = ((x.get("impressionAnalytics") or {}).get("url")) or ""
    return bool("sponsoredListing=true" in url or "/sponsoredcontent/" in impr)


def parse_listing(item, currency):
    hs = item.get("headingSection") or {}
    ss = (item.get("summarySections") or [{}])[0]
    rs = ss.get("reviewSummary") or {}
    ps = item.get("priceSection") or {}
    psum = ps.get("priceSummary") or {}
    lead, total = lead_and_total(psum.get("displayMessages"))
    reassure = (psum.get("reassuranceMessage") or {}).get("value")
    free_cancel = None  # not present as a discrete field on the listing card (measured)
    url = ((item.get("cardLink") or {}).get("resource") or {}).get("value")
    return {
        "id": item.get("id"),
        "name": hs.get("heading"),
        "area": "; ".join(m.get("text", "") for m in hs.get("messages") or [] if m.get("text")),
        "rating": money(((rs.get("graphic") or {}).get("text"))),
        "rating_text": ((rs.get("title") or {}).get("shoppingProductTitle") or {}).get("text"),
        "reviews": next((num(st.get("shoppingProductTitle", {}).get("text"))
                         for st in rs.get("subtexts") or []), None),
        "price_per_night": lead,
        "price_total": total,
        "price_basis": "per night (hotels.com's LEAD/starting rate for this party size, the cheapest bookable "
                       "unit); price_total is hotels.com's own stay total (\"總價\") for that SAME unit - not "
                       "simply price_per_night*nights (occupancy surcharges land only in the total; measured "
                       "live on ordinary hotels too). The API does not label whether taxes/fees are included in either figure: a "
                       "1-night Taipei stay showed NT$4,351/night vs NT$5,025 total, consistent with taxes/fees only in the "
                       "total but unconfirmed, so compare hotels by price_total. For budget hostels the cheapest unit can be a shared-dorm "
                       "bed, not a private room - see top-level `price_basis_note` and verify with `hotel <id>`.",
        "currency": currency,
        "availability_note": reassure,
        "free_cancellation": free_cancel,
        "sponsored": is_sponsored_listing(item),
        "url": url,
    }


def parse_search_response(data, currency):
    ps = data.get("propertySearch") or {}
    raw = ps.get("propertySearchListings") or []
    sponsored = sum(1 for x in raw if x.get("__typename") != "LodgingCard" or is_sponsored_listing(x))
    seen, items = set(), []
    for x in raw:
        if x.get("__typename") != "LodgingCard":
            continue
        if is_sponsored_listing(x):
            continue
        pid = x.get("id")
        if not pid or pid in seen:
            continue
        seen.add(pid)
        items.append(parse_listing(x, currency))
    summary = ps.get("summary") or {}
    return {
        "items": items, "dropped_sponsored": sponsored,
        "matched_total": summary.get("matchedPropertiesSize"),
        "region_id": ((ps.get("criteria") or {}).get("primary") or {}).get("destination", {}).get("regionId"),
        "raw_count": len(raw),
    }


def parse_rate_plan(rp, currency, policies):
    pd0 = (rp.get("priceDetails") or [{}])[0]
    lead, total = lead_and_total((pd0.get("price") or {}).get("displayMessages"))
    avail = (pd0.get("availability") or {}).get("scarcityMessage")
    pol = policies[rp.get("__policy_index", 0)] if policies and rp.get("__policy_index", 0) < len(policies) else None
    cancel_title = (pol or {}).get("title", {}).get("text") if pol else None
    return {
        "rate_plan_id": rp.get("id"),
        "price_per_night": lead,
        "price_total": total,
        "currency": currency,
        "price_basis": "per night / total for the stay, as shown by hotels.com",
        "availability_note": avail,
        "cancellation": cancel_title,
    }


def parse_unit(unit, currency):
    hs = unit.get("headingSection") or unit.get("header") or {}
    name = hs.get("text") if isinstance(hs, dict) else None
    features = [f.get("text") for f in unit.get("features") or [] if f.get("text")]
    sh = unit.get("secondaryHeader") or {}
    cd = (sh.get("complexDialog") or {}).get("policyContent") or {}
    policies = cd.get("policies") or []
    unit_cancel = None
    for hm in unit.get("highlightedMessages") or []:
        trig = ((hm or {}).get("trigger") or {})
        if trig.get("value"):
            unit_cancel = trig["value"] + (f" ({trig['secondaryValue']})" if trig.get("secondaryValue") else "")
            break
    sel = unit.get("primarySelections") or []
    rate_plans = []
    for sidx, s in enumerate(sel):
        pu = s.get("propertyUnit") or {}
        for i, rp in enumerate(pu.get("ratePlans") or []):
            rp = dict(rp)
            rp["__policy_index"] = i
            parsed = parse_rate_plan(rp, currency, policies)
            parsed["cancellation"] = parsed["cancellation"] or unit_cancel
            parsed["payment"] = (rp.get("paymentReassuranceMessage") or {}).get("value")
            rate_plans.append(parsed)
    return {"unit_id": unit.get("unitId"), "name": name, "features": features, "rate_plans": rate_plans}


def parse_rooms_response(data, currency):
    po = data.get("propertyOffers") or {}
    if po.get("categorizedListings") is None:
        em = (po.get("errorMessage") or {}).get("title", {}).get("text")
        return {"units": [], "unavailable_reason": em}
    units = [parse_unit(u, currency) for u in po["categorizedListings"]]
    return {"units": units, "unavailable_reason": None}


def parse_property(data):
    pi = data.get("propertyInfo") or {}
    summary = pi.get("summary") or {}
    amenities = [a.get("text") for a in ((summary.get("amenities") or {}).get("topAmenities") or {}).get(
        "infoItems") or [] if a.get("text")]
    save = pi.get("saveTripItem") or {}
    return {"id": pi.get("id"), "amenities": amenities,
            "saved": save.get("initialChecked"), "property_id_display": pi.get("propertyIdDisplay")}


def parse_ataglance(data):
    sections = ((data.get("atAGlance") or {}).get("content") or {}).get("sections") or []
    checkin = checkout = None
    raw = json.dumps(sections, ensure_ascii=False, separators=(",", ":"))
    for pair in re.finditer(r'"text":"入住","subText":"([^"]+)"', raw):
        checkin = pair.group(1)
    for pair in re.finditer(r'"text":"退房","subText":"([^"]+)"', raw):
        checkout = pair.group(1)
    return {"checkin_time": checkin, "checkout_time": checkout}


