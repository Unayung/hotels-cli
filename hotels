def cmd_trips(args):
    st = load_state()
    if not st.get("cookies") or not _signed_in(st["cookies"]):
        raise Auth("not signed in - run `hotels login`")
    with Client(argparse.Namespace(via="browser", debug=args.debug, cdp=None), st) as cl:
        br = cl.browser()
        br.navigate(ORIGIN + "/trips")
        time.sleep(3)
        tabs = {}
        for label, key in (("已預訂", "booked"), ("已儲存", "saved")):
            br.eval("(()=>{const e=[...document.querySelectorAll('[role=tab]')].find(e=>(e.innerText||'').trim()==%s);if(e)e.click()})()" % json.dumps(label))
            time.sleep(2)
            tabs[key] = br.eval("document.body.innerText")
    def empty(t, marker):
        return marker in t
    booked_empty = empty(tabs["booked"], "尚無預訂")
    saved_empty = empty(tabs["saved"], "尚無儲存項目")
    data = {"booked_empty": booked_empty, "saved_empty": saved_empty,
            "note": "read-only parse of https://tw.hotels.com/trips tabs 已預訂/已儲存 (the 已過去 tab loads lazily and is not read). "
                    "Empty states were measured live (尚無預訂 / 尚無儲存項目); the non-empty list shape was never captured, so "
                    "when not empty only raw text is returned.",
            "booked_text": None if booked_empty else tabs["booked"][:1500],
            "saved_text": None if saved_empty else tabs["saved"][:1500]}
    return emit(ok(data), args.json, lambda: (
        ("booked: none\n" if booked_empty else "booked:\n" + data["booked_text"] + "\n")
        + ("saved: none" if saved_empty else "saved:\n" + data["saved_text"])))


def cmd_saved(args):
    st = load_state()
    if not st.get("cookies") or not _signed_in(st["cookies"]):
        raise Auth("not signed in - run `hotels login`")
    if args.action == "list":
        return cmd_trips(args)

    pid = product_id(args.ref)
    rooms = build_rooms(2, [], 1)
    today = time.strftime("%Y-%m-%d", time.localtime(time.time() + 86400 * 30))
    tomorrow = time.strftime("%Y-%m-%d", time.localtime(time.time() + 86400 * 33))
    crit = search_criteria(None, None, today, tomorrow, rooms)
    url = f"{ORIGIN}/h{pid}.Hotel-Information?expediaPropertyId={pid}"
    with Client(argparse.Namespace(via="browser", debug=args.debug, cdp=None), st) as cl:
        base_vars = {"context": cl.context(), "propertyId": pid,
                    "shoppingContext": {"multiItem": None, "queryTriggeredBy": "OTHER"}, "searchCriteria": crit}
        before = parse_property(cl.gql("PropertyDetailsBasicQuery", base_vars, HASH_PROPERTY, CI_SHOP))
        want_saved = args.action == "add"
        if before.get("saved") == want_saved:
            return emit(ok({"id": pid, "already": want_saved}), args.json,
                        f"{pid} is already {'saved' if want_saved else 'not saved'}; nothing to do")
        if not args.yes:
            return emit(ok({"dry_run": True, "id": pid, "action": args.action, "currently_saved": before.get("saved")}),
                        args.json, f"would {args.action} {pid} to favourites (currently saved={before.get('saved')}). "
                        "re-run with --yes")
        br = cl.browser()
        br.p.call("Emulation.setFocusEmulationEnabled", enabled=True)  # our own tab only; renders UI sheets
        br.navigate(url)
        time.sleep(4)
        # The page's own heart button is the source of truth: its aria-label flips between
        # 將住宿儲存到行程裡 (not saved) and 將住宿從行程中移除 (saved). The GraphQL
        # saveTripItem.initialChecked stays stale after a click (measured), so it is not used to verify.
        add_lbl, rm_lbl = "將住宿儲存到行程裡", "將住宿從行程中移除"
        click_lbl = add_lbl if want_saved else rm_lbl
        clicked = br.eval("(() => { const b = Array.from(document.querySelectorAll('button')).find(x => "
                          "(x.getAttribute('aria-label')||'') === %s); if (!b) return false; b.click(); return true; })()"
                          % json.dumps(click_lbl))
        if not clicked:
            raise ApiError("could not find the save/favourite button on the hotel page")
        if not want_saved:
            # removing opens a "我的行程" side sheet; the per-trip button there does the actual removal
            for _ in range(8):
                time.sleep(1.5)
                if br.eval("(() => { const b = Array.from(document.querySelectorAll('button')).find(x => "
                           "/^從.+行程中移除住宿$/.test((x.innerText||'').trim())); if (!b) return false; b.click(); return true; })()"):
                    break
        final = None
        for _ in range(8):
            time.sleep(1.5)
            labels = br.eval("JSON.stringify(Array.from(document.querySelectorAll('button')).map(b => b.getAttribute('aria-label')||''))")
            if (rm_lbl if want_saved else add_lbl) in labels:
                final = want_saved
                break
        if final is None:
            raise ApiError("clicked the button but the page did not flip to the expected state - check `hotels saved list`")
        after = {"saved": final}
    return emit(ok({"id": pid, "saved": after.get("saved"), "verified": True}), args.json,
                f"{pid} is now {'saved' if after.get('saved') else 'not saved'} (verified)")


# ------------------------------------------------------------------ parser
class Parser(argparse.ArgumentParser):
    def error(self, message):
        as_json = "--json" in sys.argv
        emit(err(f"{self.prog}: {message}", EX_USAGE), as_json)
        if not as_json:
            self.print_usage(sys.stderr)
        sys.exit(EX_USAGE)


def csv_ints(s):
    return [int(x) for x in str(s).split(",") if x.strip()]


def build_parser():
    p = Parser(prog="hotels", description="Hotels.com Taiwan (tw.hotels.com) from the shell (no booking).")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true", help="dump requests to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="transport: auto/browser (default: background tab of Edge on CDP), "
                             "http (opt-in plain HTTPS, curl_cffi if installed; short grace, then captcha)")
    common.add_argument("--cdp", default=None, help=f"CDP endpoint (default {CDP})")
    common.add_argument("--currency", default="TWD", help="currency (default TWD; only TWD measured live)")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)

    sub.add_parser("doctor", parents=[common], help="transport, API reachability, login state"
                   ).set_defaults(fn=cmd_doctor)

    sg = sub.add_parser("suggest", parents=[common], help="typeahead / region lookup")
    sg.add_argument("text")
    sg.add_argument("--limit", type=int, default=10)
    sg.set_defaults(fn=cmd_suggest)

    s = sub.add_parser("search", parents=[common], help="search hotels")
    s.add_argument("destination", help="free text or a numeric regionId")
    s.add_argument("--checkin", required=True)
    s.add_argument("--checkout", required=True)
    s.add_argument("--adults", type=int, default=2)
    s.add_argument("--children", type=csv_ints, default=[], help="ages, comma separated, e.g. 7,4")
    s.add_argument("--rooms", type=int, default=1)
    s.add_argument("--sort", choices=list(SORTS))
    s.add_argument("--page", type=int, default=1)
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--min", type=float, help="min price/night TWD")
    s.add_argument("--max", type=float, help="max price/night TWD")
    s.add_argument("--stars", type=csv_ints, default=[], help="e.g. 3,4")
    s.add_argument("--free-cancel", action="store_true")
    s.add_argument("--breakfast", action="store_true")
    s.set_defaults(fn=cmd_search)

    h = sub.add_parser("hotel", aliases=["rooms"], parents=[common], help="rooms/rates for one hotel")
    h.add_argument("ref", help="property id or hotels.com URL with expediaPropertyId=")
    h.add_argument("--checkin", required=True)
    h.add_argument("--checkout", required=True)
    h.add_argument("--adults", type=int, default=2)
    h.add_argument("--children", type=csv_ints, default=[])
    h.add_argument("--rooms", type=int, default=1)
    h.add_argument("--region-id", default=None, help="optional, improves accuracy; omit if unknown")
    h.set_defaults(fn=cmd_hotel)

    pc = sub.add_parser("price", parents=[common], help="lowest nightly price for several hotels")
    pc.add_argument("refs", nargs="+")
    pc.add_argument("--checkin", required=True)
    pc.add_argument("--checkout", required=True)
    pc.add_argument("--adults", type=int, default=2)
    pc.add_argument("--children", type=csv_ints, default=[])
    pc.add_argument("--rooms", type=int, default=1)
    pc.add_argument("--region-id", default=None)
    pc.set_defaults(fn=cmd_price)

    lg = sub.add_parser("login", parents=[common], help="save a signed-in hotels.com session (default: Cookie header from stdin or clipboard)")
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--from-browser", action="store_true",
                   help="(opt-in) copy the session from Edge on CDP; opens the sign-in page if needed")
    g.add_argument("--from-clipboard", action="store_true", help="Cookie header from the clipboard")
    g.add_argument("--cookie-stdin", action="store_true", help="paste/pipe a Cookie header")
    lg.add_argument("--wait", type=int, default=300, help="seconds to wait for you to sign in")
    lg.add_argument("--keyring", action="store_true", help="store cookies in the OS keyring")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="delete the saved session").set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="verify the saved session against the live homepage"
                   ).set_defaults(fn=cmd_whoami)

    sub.add_parser("trips", parents=[common], help="read-only list of trips/bookings (needs login)"
                   ).set_defaults(fn=cmd_trips)

    sv = sub.add_parser("saved", parents=[common], help="favourites list/add/rm (needs login; no booking)")
    sv.add_argument("action", choices=["list", "add", "rm"])
    sv.add_argument("ref", nargs="?", help="add/rm: property id or URL")
    sv.add_argument("--yes", action="store_true", help="really write; without it only preview")
    sv.set_defaults(fn=cmd_saved)

    r = sub.add_parser("raw", parents=[common], help="GET passthrough for debugging (JSON out)")
    r.add_argument("path")
    r.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if getattr(args, "cdp", None):
        _set_cdp(args.cdp)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except Usage as e:
        return emit(err(str(e), EX_USAGE), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
